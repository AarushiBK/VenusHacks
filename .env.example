# Gemini — chat / answer generation ONLY (not embeddings)
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash

# ChromaDB — local vector store (embeddings are generated locally)
# docker run -p 8000:8000 chromadb/chroma
EXPO_PUBLIC_CHROMA_URL=http://localhost:8000
EXPO_PUBLIC_CHROMA_COLLECTION=hera_medical
CHROMA_URL=http://localhost:8000
